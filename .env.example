# ==============================================================================
# Self-Healing Lakehouse Pipeline System Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Storage & Paths Configuration
# ------------------------------------------------------------------------------
# Base path where pipeline reads and writes all data tiers
PIPELINE_DATA_ROOT=data

# Subdirectory names under PIPELINE_DATA_ROOT
PIPELINE_RAW_DIR=raw
PIPELINE_BRONZE_DIR=bronze
PIPELINE_SILVER_DIR=silver
PIPELINE_GOLD_DIR=gold
PIPELINE_REJECT_DIR=reject
PIPELINE_METADATA_DIR=metadata
PIPELINE_HEALED_EXPORTS_DIR=healed_exports

# Storage format: "delta" for Delta Lake ACID transactions, or "parquet"
PIPELINE_DATA_FORMAT=delta

# Application identifier used in Spark session naming
PIPELINE_APP_NAME=self_healing_lakehouse_pipeline

# ------------------------------------------------------------------------------
# Ingestion & Source Contracts
# ------------------------------------------------------------------------------
# Comma-separated glob patterns to discover incoming unstructured files
PIPELINE_SOURCE_PATTERNS=*.csv,*.json,*.log,*.txt

# ------------------------------------------------------------------------------
# Spark Performance Tuning
# ------------------------------------------------------------------------------
# Number of shuffle partitions (tune according to data scale and cluster cores)
PIPELINE_SHUFFLE_PARTITIONS=4

# Target maximum records written per output part file
PIPELINE_MAX_RECORDS_PER_FILE=50000

# ------------------------------------------------------------------------------
# Alerts & Observability Thresholds
# ------------------------------------------------------------------------------
# Optional webhook URL for Slack / Discord / Teams / PagerDuty alert notifications
PIPELINE_ALERT_WEBHOOK_URL=

# Reject rate ratio (0.0 to 1.0) above which a warning/critical alert is triggered
# Default: 0.15 (15% bad records triggers alert)
PIPELINE_ALERT_REJECT_RATE_THRESHOLD=0.15

# ------------------------------------------------------------------------------
# Demo Simulator Settings
# ------------------------------------------------------------------------------
# Frequency in seconds at which the background simulator generates new hospital files
PIPELINE_BACKEND_GENERATION_INTERVAL_SECONDS=20

# Number of files generated per simulation batch
PIPELINE_BACKEND_BATCH_SIZE=3

# ------------------------------------------------------------------------------
# Apache Airflow & PostgreSQL Stack Configuration
# ------------------------------------------------------------------------------
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__WEBSERVER__SECRET_KEY=pipeline-demo-secret-key-change-in-production
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_EMAIL=admin@example.com

POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
